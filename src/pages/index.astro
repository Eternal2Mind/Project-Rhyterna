---
// Root entry: redirect to the visitor's language (mirrors the old index.html).
// Kept client-side so the navigator.language preference is honoured on a
// static host; the <meta refresh> is the no-JS fallback.
---
<!DOCTYPE html>
<html>
<head>
  <link rel="icon" type="image/svg+xml" href="/Assets/Images/whminilogo.svg" />
  <meta charset="UTF-8" />
  <script is:inline>
    var lang = navigator.language || navigator.userLanguage || '';
    var target = lang.toLowerCase().startsWith('tr') ? '/tr/' : '/en/';
    window.location.replace(target);
  </script>
  <meta http-equiv="refresh" content="0; url=/en/" />
</head>
</html>
