---
import type { UIStrings } from '../i18n/ui';

interface Props {
  t: UIStrings;
}

const { t } = Astro.props;
---
<div class="ust-bar" id="ust-bar">
  <div class="ust-bar-ic">

    <a class="ust-seg" data-id="0" href="#home">{t.topbar.home}</a>

    <a class="ust-seg" data-id="1" href="#lex-rhyterna">{t.topbar.lex}</a>

    <a class="ust-seg" data-id="2" href="#devlog">{t.topbar.devlog}</a>

    <a class="ust-seg" data-id="3" href="#social">{t.topbar.contact}</a>

  </div>
</div>
