{
  "name": "medyaindir-web",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "customizations": {
    "vscode": {
      "extensions": [
        "ritwickdey.LiveServer"
      ]
    }
  },
  "forwardPorts": [5500],
  "portsAttributes": {
    "5500": {
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "curl -fsSL https://claude.ai/install.sh | bash"
}